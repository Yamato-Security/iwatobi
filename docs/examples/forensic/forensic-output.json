      "custom_formats_yaml": "# Custom log formats.\n#\n# Iwatobi recognizes syslog, Apache/nginx access logs (common, combined, vhost_combined, JSON lines),\n# Apache/nginx error logs, PHP error logs and php-fpm logs by itself, and works out the layout of most\n# other web server access logs automatically. Describe a log here when it is skipped as\n# \"unrecognized log format\", or to pin or correct a layout that was detected automatically.\n#\n# Each format needs a unique name and exactly one of:\n#\n#   nginx:  an nginx log_format string, or the whole log_format directive from nginx.conf\n#   apache: an Apache LogFormat string, or the whole LogFormat directive from the Apache config\n#   regex:  a regular expression with named groups, one per field: (?P<name>...)\n#\n# Optional settings:\n#\n#   files:       file name patterns (* ? [abc]) the format is used for. Without them, the format is\n#                tried on every file whose format is not forced with --log-format, before the\n#                built-in formats, and used when it matches at least half of the first lines.\n#                A pattern with a / is matched against the whole path.\n#   time_format: the format of the time field in chrono strftime syntax (ex: '%Y-%m-%d %H:%M:%S').\n#                Without it, CLF ([10/Oct/2026:13:55:36 +0900]), ISO 8601 and epoch times are read.\n#                Times without a zone are read in the zone given with -z.\n#   logsource:   (regex only) the Sigma logsource of the log, default {category: webserver}.\n#                Ex: {product: linux, service: auth}, {product: apache, service: error}.\n#\n# Web server access logs (nginx, apache, and regex formats with the webserver logsource) are mapped\n# to the Sigma webserver fields. These variable / group names are recognized:\n#\n#   remote_addr, client_ip   -> c-ip              request_method -> cs-method\n#   request_uri, uri + args  -> cs-uri-query      request (GET /x HTTP/1.1) -> method, URI, version\n#   server_protocol          -> cs-version        status         -> sc-status\n#   body_bytes_sent, bytes_sent -> sc-bytes       http_referer   -> cs-referer\n#   http_user_agent          -> cs-user-agent     host, http_host, server_name -> cs-host\n#   remote_user              -> cs-username\n#   time_local, time_iso8601, msec, time, timestamp -> the event time\n#\n# Any other variable or group is kept under its own name and shown in Details. In a regex, write\n# the taxonomy names with _ instead of - (c_ip, cs_method, sc_status, ...).\n#\n# Examples:\n#\n# formats:\n#   # An nginx log_format (paste it from nginx.conf; the whole log_format directive works too)\n#   - name: shop-nginx\n#     nginx: '$remote_addr - $remote_user [$time_local] \"$request\" $status $body_bytes_sent \"$http_referer\" \"$http_user_agent\" $request_time $upstream_response_time'\n#     files: ['shop-access.log*']\n#\n#   # An Apache LogFormat\n#   - name: intranet-apache\n#     apache: '%v %h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\" %D'\n#\n#   # Any other log: a regex and its Sigma logsource\n#   - name: vpn-auth\n#     regex: '^(?P<timestamp>\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d) (?P<hostname>\\S+) vpnd: (?P<message>.*)$'\n#     time_format: '%Y-%m-%d %H:%M:%S'\n#     logsource: {product: linux, service: auth}\n\nformats:\n",
      "forced_format": null,
