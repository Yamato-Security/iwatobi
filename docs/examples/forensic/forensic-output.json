      "rule": {
        "author": "Zach Mathis (@yamatosecurity)",
        "created": "2026-10-26",
        "description": "Detects three or more POST requests to the web root or index.php from the same client within 60 seconds.\nThe PHP2Shell (CVE-2026-109618) exploit chain sends four large multipart POSTs (memory pressure, memory\ndisclosure, memory pressure, execution) to / or /index.php within a few seconds, typically without a\nUser-Agent header. The final request often has no access-log entry because the worker crashes, so the\nthreshold is three.",
        "false_positives": [
          "Forms, APIs and login pages that legitimately receive bursts of POST requests to the index page"
        ],
        "file": "web_rapid_posts_to_php_index.yml",
        "id": "1f36585e-0f83-4f4b-8a5a-b0194f9f798c",
        "level": "medium",
        "modified": null,
        "name": "Rapid Repeated POST Requests To PHP Index Page",
        "references": [
          "https://github.com/0x4D31/honeypot-data/blob/main/reports/php2shell/2026-10-24-confirmed-rce.md",
          "https://www.wiz.io/blog/php2shell-php-rce"
        ],
        "source": {
